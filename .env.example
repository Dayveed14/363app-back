# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Database (MySQL-compatible — TiDB Cloud) ---
# Get these from your cluster's "Connect" page in the TiDB Cloud console.
# Example serverless host: gateway01.us-east-1.prod.aws.tidbcloud.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cooperative_363
DB_CONNECTION_LIMIT=10
# TiDB Cloud requires TLS on its public endpoint — set true when DB_HOST
# points at TiDB Cloud (leave false for a local MySQL/MariaDB in dev).
DB_SSL=false
# Only needed if your cluster needs a specific CA bundle — TiDB Cloud's
# serverless tier is signed by a publicly trusted CA, so this is normally
# left blank.
DB_SSL_CA_PATH=

# --- JWT ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Each of the four below must be a DIFFERENT value — reusing one secret
# across token types means a leak of one compromises all of them.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_PENDING_2FA_SECRET=change-me-pending-2fa-secret
JWT_PENDING_WITHDRAWAL_SECRET=change-me-pending-withdrawal-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PENDING_2FA_EXPIRES_IN=10m
JWT_PENDING_WITHDRAWAL_EXPIRES_IN=10m

# --- Auth cookies ---
# Every token (access, refresh, pending-2FA, pending-withdrawal) is set as
# an httpOnly cookie — never returned in a JSON body, never touched by
# frontend JS.
COOKIE_ACCESS_NAME=access_token
COOKIE_REFRESH_NAME=refresh_token
COOKIE_PENDING_2FA_NAME=pending_2fa_token
COOKIE_PENDING_WITHDRAWAL_NAME=pending_withdrawal_token
# Only set this if frontend + backend end up sharing a parent domain (e.g.
# app.363resources.com / api.363resources.com -> COOKIE_DOMAIN=.363resources.com).
# Leave blank while they're on unrelated domains (e.g. Vercel + Render).
COOKIE_DOMAIN=

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Pepper mixed into the OTP hash so a raw DB leak alone can't be brute-forced offline.
OTP_HASH_PEPPER=change-me-otp-pepper

# --- Outbound email (Resend) ---
# From the Resend dashboard → API Keys. On Render: add as an environment
# variable on the web service, never commit it.
RESEND_API_KEY=re_change_me
# Must be on a domain you've verified in Resend — their sandbox sender only
# delivers to your own Resend account email until a real domain is verified.
EMAIL_FROM="363 Cooperative Society <no-reply@363resources.com>"

# --- Paystack (deposits) ---
# From your Paystack dashboard → Settings → API Keys & Webhooks.
# Use the sk_test_ / pk_test_ pair while developing.
PAYSTACK_SECRET_KEY=sk_test_change_me
PAYSTACK_PUBLIC_KEY=pk_test_change_me
# Where Paystack sends the member's browser back to after checkout. Defaults
# to CLIENT_ORIGIN + /deposit/callback if unset.
PAYSTACK_CALLBACK_URL=http://localhost:5173/deposit/callback

# --- File uploads (KYC documents) ---
UPLOAD_MAX_FILE_SIZE_MB=5

# --- Cloudinary (KYC document storage) ---
# From your Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
